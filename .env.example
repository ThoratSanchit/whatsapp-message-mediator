# Environment configuration
NODE_ENV=development
LOG_LEVEL=info

# Storage and logs path
SESSION_PATH=./session
LOG_PATH=./logs

# Allowed group chats filtering (semicolon-separated list of group JIDs or fuzzy Group Names)
# This serves as a client-side filter to prevent querying the database for every single incoming message
# in unrelated chats (e.g. personal, family, or meme groups), saving database connections and memory load.
# Future enhancement: Implement an in-memory cache of allowed group JIDs loaded from the database at startup.
# If empty, all group/private messages will trigger a database lookup.
ALLOWED_GROUPS=

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cnglive
DB_PORT=5432
