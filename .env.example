# Environment configuration
NODE_ENV=development
LOG_LEVEL=info

# Storage and logs path
SESSION_PATH=./session
LOG_PATH=./logs

# Allowed group chats filtering (comma-separated list of group JIDs, e.g. 12036301111@g.us,12036302222@g.us)
# If empty, all group and private chat messages will be allowed
ALLOWED_GROUPS=

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cnglive
DB_PORT=5432
